**input**
import numpy as np

# Sample data
X = np.array([1.0, 1.2, 1.4, 1.5, 5.0, 5.2, 5.4, 5.5])

# Number of clusters
K = 2

# Initial parameters
means = np.array([1.2, 5.2])
variances = np.array([1.0, 1.0])
weights = np.array([0.5, 0.5])

# Number of iterations
iterations = 20


# Gaussian probability density function
def gaussian(x, mean, variance):
    return (1 / np.sqrt(2 * np.pi * variance)) * \
           np.exp(-((x - mean) ** 2) / (2 * variance))


# EM Algorithm
for iteration in range(iterations):

    # ---------------- E-Step ----------------
    responsibilities = np.zeros((len(X), K))

    for i in range(len(X)):
        for k in range(K):
            responsibilities[i, k] = (
                weights[k] * gaussian(X[i], means[k], variances[k])
            )

        # Normalize responsibilities
        responsibilities[i] /= np.sum(responsibilities[i])

    # ---------------- M-Step ----------------
    Nk = np.sum(responsibilities, axis=0)

    for k in range(K):
        # Update mean
        means[k] = np.sum(responsibilities[:, k] * X) / Nk[k]

        # Update variance
        variances[k] = np.sum(
            responsibilities[:, k] * (X - means[k]) ** 2
        ) / Nk[k]

        # Update weight
        weights[k] = Nk[k] / len(X)


# Display results
print("Final Results after EM Algorithm:")
print("----------------------------------")

for k in range(K):
    print(f"Cluster {k + 1}:")
    print(f"Mean     = {means[k]:.4f}")
    print(f"Variance = {variances[k]:.4f}")
    print(f"Weight   = {weights[k]:.4f}")
    print()

# Assign each data point to the cluster
cluster_assignment = np.argmax(responsibilities, axis=1) + 1

print("Cluster Assignments:")
for i in range(len(X)):
    print(f"Data {X[i]:.1f} -> Cluster {cluster_assignment[i]}")

